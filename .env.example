# === Supabase (required for case commit + audit trail) ===
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# === ElevenLabs (optional — for live voice intake) ===
# Without these, use the "Simulate" button for the demo flow.
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
VITE_ELEVENLABS_AGENT_ID="your-elevenlabs-agent-id"

# === AI Classification (optional — falls back to keyword classifier) ===
# Option A: Any OpenAI-compatible API (OpenAI, OpenRouter, local LLM, etc.)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Option B: Lovable AI Gateway (original, only works on Lovable platform)
# LOVABLE_API_KEY=""
